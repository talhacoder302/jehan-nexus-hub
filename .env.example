# --- Core (required) ---
MONGODB_URI=
AUTH_SECRET=
AUTH_URL=
NEXT_PUBLIC_SITE_URL=

# --- Google sign-in (optional) ---
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Seed script ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- AWS S3 for post creatives and report PDFs (optional) ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# --- Resend transactional email (optional; emails are logged when missing) ---
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFY_EMAIL=

# --- Pusher Channels (optional; falls back to 30s polling) ---
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# --- Meta Marketing API (optional; seeded data is used when missing) ---
META_API_VERSION=
META_SYSTEM_USER_TOKEN=
META_APP_ID=
META_APP_SECRET=

# --- Cron ---
CRON_SECRET=
